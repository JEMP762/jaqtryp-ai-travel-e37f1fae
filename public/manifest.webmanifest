{
  "name": "Jaqtryp — Viagens com IA",
  "short_name": "Jaqtryp",
  "description": "Super app de viagens com IA: roteiros, voos, tradução ao vivo e assistente em tempo real.",
  "start_url": "/dashboard",
  "id": "/dashboard",

  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b0b12",
